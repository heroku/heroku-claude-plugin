{
  "name": "heroku-plugin",
  "version": "0.1.0",
  "description": "Scaffold and deploy applications to Heroku from natural language prompts.",
  "author": {
    "name": "jwinn"
  },
  "keywords": ["heroku", "scaffold", "deployment", "docker", "buildpack"],
  "license": "MIT",
  "policy": {
    "reference_staleness_days": 30,
    "deploy_mode": "cli",
    "mcp_stub": false,
    "supported_stacks": ["node", "python", "rails", "go"],
    "supported_addons": ["heroku-postgresql", "heroku-redis"],
    "unsupported_addons": ["kafka"]
  }
}
